# Environment for the hosted relay. Copy it outside the checkout (for example
# /srv/isoform-relay/relay.env, mode 0600) and fill in the placeholders. On Fly,
# set the same names with `fly secrets set NAME=value`; the listener settings
# below are already in fly.toml.
#
# Every value here is either a setting or a secret. Nothing in this file is
# user data: the relay stores only credential digests and ciphertext.

# --- Listener (the compose file sets these; shown for a bare host) ----------
# ISOFORM_RELAY_ADDR=127.0.0.1:8791
# ISOFORM_RELAY_STATE_DIR=/var/lib/isoform
# Plaintext off loopback is allowed only behind a TLS-terminating proxy that
# is named in ISOFORM_RELAY_TRUSTED_PROXIES. Fly: fdaa::/16,172.16.0.0/12 and
# Fly-Client-IP. Caddy on the same host: the loopback default and
# X-Forwarded-For.
# ISOFORM_RELAY_BEHIND_TLS_PROXY=0
# ISOFORM_RELAY_TRUSTED_PROXIES=127.0.0.0/8,::1/128
# ISOFORM_RELAY_CLIENT_IP_HEADER=X-Forwarded-For
# ISOFORM_RELAY_MAX_CONNS=4096
# ISOFORM_RELAY_LOG_FORMAT=json

# --- APNs (optional, all-or-nothing). Wakes phones when a brief arrives. -----
# The .p8 auth key from developer.apple.com, bound read-only into the
# container (docker-compose.yml: ISOFORM_RELAY_APNS_KEY_HOST_FILE) or stored on
# Fly as a secret with `fly secrets set ISOFORM_RELAY_APNS_KEY_FILE=...` after
# copying it onto the volume (README: "APNs on Fly").
# ISOFORM_RELAY_APNS_KEY_FILE=/run/secrets/apns-key.p8
# ISOFORM_RELAY_APNS_KEY_ID=ABCDE12345
# ISOFORM_RELAY_APNS_TEAM_ID=TEAMID1234
# ISOFORM_RELAY_APNS_TOPIC=app.yansu.ios
# ISOFORM_RELAY_APNS_ENVIRONMENT=production

# --- Text messages (optional; docs/sms-channel.md) --------------------------
# ISOFORM_RELAY_SMS_PROVIDER=twilio
# ISOFORM_RELAY_SMS_KEY=<openssl rand -base64 32>
# ISOFORM_RELAY_SMS_HASH_KEY=<the first ISOFORM_RELAY_SMS_KEY ever used; never changed>
# ISOFORM_RELAY_SMS_HELP_CONTACT=support@example.com
# ISOFORM_RELAY_SMS_WEBHOOK_URL=https://relay.example.com/v1/sms/inbound
# ISOFORM_RELAY_TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
# ISOFORM_RELAY_TWILIO_AUTH_TOKEN=<twilio auth token>
# ISOFORM_RELAY_TWILIO_MESSAGING_SERVICE_SID=MG00000000000000000000000000000000

# --- Email (optional; docs/email-channel.md) --------------------------------
# ISOFORM_RELAY_EMAIL_PROVIDER=smtp
# ISOFORM_RELAY_EMAIL_KEY=<openssl rand -base64 32>
# ISOFORM_RELAY_EMAIL_FROM=Yansu <no-reply@example.com>
# ISOFORM_RELAY_SMTP_HOST=smtp.example.com
# ISOFORM_RELAY_SMTP_PORT=587
# ISOFORM_RELAY_SMTP_USERNAME=<smtp user>
# ISOFORM_RELAY_SMTP_PASSWORD=<smtp password>
# ISOFORM_RELAY_SMTP_MODE=starttls
